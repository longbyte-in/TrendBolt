# ==========================
# TrendBolt .env.example
# Copy to .env and fill values
# ==========================

# --- Reddit ---
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=TrendBolt/1.0 by your_handle

# --- LLM (choose Azure OpenAI or OpenAI fallback) ---
# Azure OpenAI (preferred)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# OpenAI (fallback)
# OPENAI_API_KEY=

# --- Canva Connect (OAuth PKCE) ---
CANVA_API_CLIENT_ID=
CANVA_API_CLIENT_SECRET=
CANVA_REDIRECT_URI=https://d0ec209c3d1c.ngrok-free.app
CANVA_SCOPES=design:content:read export:read

# --- Azure Blob Storage (default storage) ---
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_CONTAINER=posts

# Option A: Connection string
AZURE_STORAGE_CONNECTION_STRING=

# Option B: AAD service principal (leave connection string empty)
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=

# --- Facebook ---
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=

# --- Optional app settings ---
# LOG_LEVEL=INFO
# SUBREDDITS=technology,worldnews
# MIN_SCORE=200
# TEMPLATE_ID=trendbolt_template_default
