# ==========================
# TrendBolt .env.example
# Copy to .env and fill values
# ==========================

# --- Reddit ---
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=TrendBolt/1.0 by your_handle

# --- LLM (choose Azure OpenAI or OpenAI fallback) ---
# Azure OpenAI (preferred)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# OpenAI (fallback)
# OPENAI_API_KEY=

# --- Canva Connect (Access Token) ---
CANVA_ACCESS_TOKEN=
CANVA_BRAND_TEMPLATE_ID=

# (Azure Blob Storage removed; images are sent directly to LinkedIn)

# --- LinkedIn ---
# Note: LinkedIn Advertising API with Development Tier access
# Apply at: https://www.linkedin.com/developers/apps
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_PAGE_ID=
LINKEDIN_ACCESS_TOKEN=

# --- Optional app settings ---
# LOG_LEVEL=INFO
# SUBREDDITS=technology,worldnews
# MIN_SCORE=200
